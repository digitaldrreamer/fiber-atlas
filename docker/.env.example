# Copy to docker/.env and fill in. docker/.env is gitignored.
#
# Fiber Atlas holds no funds and opens no channels on either network, so nothing
# here controls spending. See docker/fnn-entrypoint.sh for how that is enforced.

# Encrypts each fnn node's wallet key at rest. Required by fnn even observe-only.
# Generate one:  openssl rand -hex 32
FIBER_SECRET_KEY_PASSWORD=

# Pin the version the NETWORK runs, not releases/latest — plan.md §1.2. A node on
# the wrong version peers with nobody and serves a frozen graph without erroring.
# Verify against the `version` distribution in graph_nodes before bumping.
FNN_VERSION=v0.9.0-rc7

# Public CKB endpoints with the indexer enabled. Both verified 2026-07-31.
TESTNET_CKB_RPC_URL=https://testnet.ckbapp.dev/
MAINNET_CKB_RPC_URL=https://mainnet.ckbapp.dev/

# Seconds between L1 scan passes. Scans are cursor-resumable, so a pass after the
# initial backfill is short.
SCAN_INTERVAL=3600


# Host port for the API. Behind a reverse proxy this need not be published.
API_PORT=8080
